# ============================================
# BIRCHTREE FINANCIAL - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# Command: cp example.env .env.local

# ============================================
# ANTHROPIC API (Required for AI Features)
# ============================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Required for: Site chatbot, Risk Profiler AI summaries, Calculator AI insights, Blog generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# SUPABASE (Optional - Recommended for Lead Management)
# ============================================
# Get these from your Supabase project: https://supabase.com/dashboard
# Required for: Lead capture, email automation, referral system, admin dashboard
# If not set, these features will gracefully degrade
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# RESEND (Email Service - Optional but Recommended)
# ============================================
# Get your API key from: https://resend.com/api-keys
# Required for: Sending emails (tool results, welcome emails, drip campaigns)
# If not set, email features will be disabled
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM_ADDRESS="Birchtree Financial <no-reply@birchtreefinancial.ca>"

# ============================================
# ADMIN DASHBOARD (Optional)
# ============================================
# Set a secret key to protect admin routes
# Used for: Admin dashboard access, blog post generation
ADMIN_DASHBOARD_SECRET=your_admin_secret_here

# ============================================
# NOTES
# ============================================
# - All variables are optional except ANTHROPIC_API_KEY (if you want AI features)
# - The site will work without any of these, but features will be disabled
# - Never commit .env.local to git (it's already in .gitignore)
# - For production (Vercel), add these same variables in your Vercel dashboard

